{
  "expo": {
    "name": "The Word",
    "slug": "the-word",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "theword",
    "plugins": [
      "expo-font",
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "com.theword.reader",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The Word uses the camera when you join a group study.",
        "NSMicrophoneUsageDescription": "The Word uses the microphone when you join a group study."
      }
    },
    "android": {
      "package": "com.theword.reader",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "amosroger91.github.io",
              "pathPrefix": "/The-Word"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
