{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@the-word/core": [
        "../../packages/core/src/index.ts"
      ],
      "@the-word/bible": [
        "../../packages/bible/src/index.ts"
      ],
      "@the-word/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
