{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@the-word/bible": ["../bible/src/index.ts"],
      "@the-word/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
